{
  "name": "bir-hesab",
  "version": "1.0.13",
  "description": "Bir Hesab - Offline-first Persian accounting desktop app",
  "main": "src/main.js",
  "scripts": {
    "start": "node ./scripts/start-electron.js",
    "dev": "node ./scripts/start-electron.js",
    "check:syntax": "node ./scripts/check-syntax.js",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:native",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "build:win:fresh": "npm run rebuild:native && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "pack:dir": "npm run rebuild:native && electron-builder --dir",
    "git:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/connect-github.ps1",
    "git:setup:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-github-automation.ps1",
    "release:patch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 -Increment patch",
    "release:minor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 -Increment minor",
    "release:major": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release.ps1 -Increment major",
    "release:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-release.ps1 -Build"
  },
  "keywords": [
    "electron",
    "accounting",
    "sqlite",
    "persian",
    "rtl"
  ],
  "author": "Bir Hesab Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashar0134/bir-hesab.git"
  },
  "bugs": {
    "url": "https://github.com/yashar0134/bir-hesab/issues"
  },
  "homepage": "https://github.com/yashar0134/bir-hesab",
  "dependencies": {
    "@majidh1/jalalidatepicker": "^0.9.12",
    "better-sqlite3": "^12.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.birhesab.desktop",
    "productName": "Bir Hesab",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "updater/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icons/app.ico",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "sign": "./scripts/windows-no-sign.js"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Bir-Hesab-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "warningsAsErrors": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico",
      "installerHeaderIcon": "assets/icons/app.ico"
    }
  }
}
